# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string - replace with your own cluster URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mini-saas-template-store?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS - frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
